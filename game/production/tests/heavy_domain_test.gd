extends GdUnitTestSuite
const Rear = preload("res://game/staffing/rear_simulation.gd")
const Heavy = preload("res://game/production/heavy_production.gd")
const Fixed = preload("res://game/production/fixed_production.gd")
const Specs = preload("res://game/production/vehicle_specs.gd")
const Base = preload("res://game/rear_base/base_simulation.gd")

func _fixture(recipe: String = "R25", operators: int = 8, live: int = 1) -> Dictionary:
	var rear := Rear.new("Empty")
	for index in range(live - 1):
		# Declared existing strategic trips keep fleet membership, without occupying parking.
		rear.ledger.add_carrier("travelling-%d" % index,"away",rear.PLAYER,rear.PLAYER,"T01","Rear")
	rear.heavy_production = Heavy.new(rear,Heavy.CHOICES)
	var owner: RefCounted = rear.heavy_production
	owner.request_recipe(recipe)
	owner.set_mode("Continuous")
	for index in operators: rear.add_person("operator-%02d" % index,false,"None","duty-vehicle_works")
	rear.set_target("vehicle_works",operators)
	return {"rear":rear,"owner":owner,"spec":Fixed.RECIPES[recipe]}

func _seed(f: Dictionary, except: String = "") -> void:
	for type in f.spec.inputs:
		if type != except: f.rear.ledger.add_stock("local-"+type,type,f.spec.inputs[type],1.0,"vehicle_input",f.rear.PLAYER)

func test_six_recipe_rows_and_five_empty_hull_catalogues_match_canonical_gdd() -> void:
	var text := FileAccess.get_file_as_string("res://docs/game_design_document.md")
	var recipe := RegEx.create_from_string("^\\| (R[0-9]+) \\| 1 ([ET][0-9]+) [^|]+ \\| ([^|]+) \\| Vehicle Works \\| ([0-9]+) \\|$")
	var ingredients := RegEx.create_from_string("([0-9]+) (M[0-9]+)")
	var hull := RegEx.create_from_string("^\\| (T0[1-5]) [^|]+ \\| ([0-9]+) \\| ([0-9]+) \\| ([0-9]+) \\| ([0-9]+) \\| ([0-9]+) \\| ([0-9.]+) by ([0-9.]+) \\|$")
	var recipes := 0
	var hulls := 0
	for line in text.split("\n"):
		var row := recipe.search(line)
		if row != null:
			var id := row.get_string(1)
			var spec: Dictionary = Fixed.RECIPES[id]
			assert_array(Heavy.CHOICES).contains(id)
			assert_str(spec.output_type).is_equal(row.get_string(2))
			assert_float(spec.work).is_equal(float(row.get_string(4)))
			var inputs := {}
			for input in ingredients.search_all(row.get_string(3)): inputs[input.get_string(2)] = int(input.get_string(1))
			assert_dict(spec.inputs).is_equal(inputs)
			assert_int(spec.output_count).is_equal(1)
			assert_str(spec.output_store).is_equal("heavy-bay")
			recipes += 1
		var vehicle := hull.search(line)
		if vehicle != null:
			var type := vehicle.get_string(1)
			var spec: Dictionary = Specs.TYPES[type]
			assert_int(spec.stations.size()).is_equal(int(vehicle.get_string(2)))
			assert_int(spec.passenger_seats).is_equal(int(vehicle.get_string(3)))
			assert_float(spec.payload).is_equal(float(vehicle.get_string(4)))
			assert_float(spec.mass).is_equal(float(vehicle.get_string(5)))
			assert_int(spec.health).is_equal(int(vehicle.get_string(6)))
			assert_vector(spec.footprint).is_equal(Vector2(float(vehicle.get_string(7)),float(vehicle.get_string(8))))
			hulls += 1
	assert_int(recipes).is_equal(6)
	assert_int(hulls).is_equal(5)
	assert_int(Fixed.RECIPES.size()).is_equal(29)

func test_all_six_reserve_before_inputs_and_complete_exact_work_into_one_retained_empty_object() -> void:
	for recipe in Heavy.CHOICES:
		var f := _fixture(recipe)
		assert_dict(f.rear.ledger.snapshot().consumed).is_empty()
		assert_bool(f.owner.accept_order().ok).override_failure_message(recipe).is_true()
		assert_str(f.owner.snapshot().order.state).is_equal("Accepted")
		assert_int(f.owner.snapshot().fleet.reserved).is_equal(0 if recipe == "R13" else 1)
		assert_dict(f.owner.batch).is_empty()
		assert_dict(f.rear.ledger.snapshot().consumed).is_empty()
		_seed(f)
		f.rear.advance_time(0)
		assert_dict(f.rear.ledger.snapshot().consumed).is_equal(f.spec.inputs)
		assert_int(f.owner.snapshot().output_promise.slots).is_equal(1)
		var stale: Dictionary = f.owner.request_recipe("R28" if recipe != "R28" else "R25")
		assert_bool(stale.confirmation_required).is_true()
		f.rear.advance_time(f.spec.work / 8.0 - 0.001)
		assert_str(f.owner.bay_occupant).is_empty()
		f.rear.advance_time(0.001)
		assert_bool(f.owner.confirm_recipe(stale.token).ok).is_false()
		var view: Dictionary = f.owner.snapshot()
		var output: Dictionary = view.bay.physical
		assert_str(output.design_type).override_failure_message(recipe).is_equal(f.spec.output_type)
		assert_str(output.holder_id).is_equal("heavy-bay")
		assert_float(output.unit_mass_kg).is_equal(f.spec.unit_mass)
		assert_float(f.owner.history[0].work).is_equal(f.spec.work)
		assert_int(view.fleet.live).is_equal(1 if recipe == "R13" else 2)
		assert_int(view.fleet.reserved).is_zero()
		if recipe == "R13":
			assert_str(output.kind).is_equal("HEAVY_OBJECT")
			assert_float(output.unit_mass_kg).is_equal(180.0)
			assert_int(output.health).is_equal(400)
			assert_dict(output.ammunition).is_empty()
			assert_bool(f.rear.ledger.transfer_stock(output.id,1,"depot").ok).is_false()
			assert_str(view.bay.clearance).contains("two loaders")
		else:
			assert_str(output.kind).is_equal("CARRIER")
			assert_float(output.fuel).is_zero()
			assert_array(output.crew).is_empty()
			assert_array(output.passengers).is_empty()
			assert_dict(output.ammunition).is_empty()
			assert_dict(output.vehicle_spec).is_equal(Specs.TYPES[f.spec.output_type])
			assert_str(view.bay.clearance).contains("Awaiting Qualified Driver")
			assert_str(view.bay.clearance).contains("Fuel Empty")
			assert_int(f.rear.ledger.total_stock("E05")).is_zero()
		var before: Dictionary = f.rear.ledger.snapshot()
		assert_bool(f.owner.accept_order().ok).is_false()
		f.rear.advance_time(100)
		assert_int(f.owner.history.size()).is_equal(1)
		f.owner.cancel()
		f.owner.resume()
		assert_str(f.owner.bay_occupant).is_equal(output.id)
		assert_dict(f.rear.ledger.snapshot().consumed).is_equal(before.consumed)
		assert_int(f.owner.snapshot().fleet.live).is_equal(view.fleet.live)
		assert_array(f.rear.audit()).is_empty()

func test_seven_live_one_accepted_admission_waits_at_earned_work_then_converts_to_eight_once() -> void:
	var f := _fixture("R25",8,7)
	assert_bool(f.owner.accept_order().ok).is_true()
	var claim: Dictionary = f.owner.snapshot().order.duplicate(true)
	assert_int(f.owner.snapshot().fleet.live).is_equal(7)
	assert_int(f.owner.snapshot().fleet.reserved).is_equal(1)
	_seed(f)
	f.rear.advance_time(1)
	f.owner.set_access(true,false)
	f.rear.advance_time(200)
	assert_float(f.owner.batch.work).is_equal(800.0)
	assert_str(f.owner.bay_occupant).is_empty()
	assert_int(f.owner.snapshot().fleet.live).is_equal(7)
	assert_int(f.owner.snapshot().fleet.reserved).is_equal(1)
	assert_str(f.owner.snapshot().order.id).is_equal(claim.id)
	assert_bool(f.owner.accept_order().ok).is_false()
	var consumed: Dictionary = f.rear.ledger.snapshot().consumed
	f.owner.set_stock_target(0)
	f.rear.set_target("vehicle_works",0)
	f.owner.set_access(true,true)
	assert_str(f.owner.bay_occupant).is_not_empty()
	assert_float(f.owner.history[0].work).is_equal(800.0)
	assert_int(f.owner.snapshot().fleet.live).is_equal(8)
	assert_int(f.owner.snapshot().fleet.reserved).is_zero()
	f.rear.advance_time(1000)
	assert_dict(f.rear.ledger.snapshot().consumed).is_equal(consumed)
	assert_int(f.owner.history.size()).is_equal(1)
	assert_bool(f.rear.ledger.release_rear_hull(claim.id,"F10 heavy production").ok).is_false()
	assert_int(f.owner.snapshot().fleet.live).is_equal(8)
	assert_array(f.rear.audit()).is_empty()

func test_full_rear_fleet_refuses_unaccepted_request_atomically_but_field_gun_needs_no_fleet_slot() -> void:
	var f := _fixture("R25",8,8)
	_seed(f)
	var before: Dictionary = f.rear.ledger.snapshot()
	var reserved: Array = f.rear.yard.reserved.duplicate()
	assert_bool(f.owner.accept_order().ok).is_false()
	assert_bool(f.rear.ledger.reserve_rear_hull("planned-military",f.rear.PLAYER,"planned military destination").ok).is_false()
	assert_dict(f.owner.snapshot().order).is_empty()
	assert_dict(f.rear.ledger.snapshot()).is_equal(before)
	assert_array(f.rear.yard.reserved).is_equal(reserved)
	assert_bool(f.owner.request_recipe("R13").ok).is_true()
	assert_bool(f.owner.accept_order().ok).is_true()
	assert_int(f.owner.snapshot().fleet.reserved).is_zero()
	f.rear.advance_time(75)
	assert_str(f.owner.snapshot().bay.physical.design_type).is_equal("E13")
	assert_int(f.owner.snapshot().fleet.live).is_equal(8)
	assert_array(f.rear.audit()).is_empty()

func test_waiting_order_cancellation_releases_only_own_promises_and_confirmed_consumed_change_keeps_loss() -> void:
	var f := _fixture("R25")
	assert_bool(f.owner.accept_order().ok).is_true()
	assert_int(f.owner.snapshot().fleet.reserved).is_equal(1)
	f.owner.set_stock_target(0)
	f.owner.cancel()
	assert_int(f.owner.snapshot().fleet.reserved).is_zero()
	assert_dict(f.rear.ledger.snapshot().consumed).is_empty()
	f.owner.resume()
	f.owner.accept_order()
	_seed(f)
	f.rear.advance_time(5)
	var before: Dictionary = f.owner.batch.duplicate(true)
	var request: Dictionary = f.owner.request_recipe("R28")
	assert_bool(request.confirmation_required).is_true()
	f.owner.decline_recipe(request.token)
	assert_dict(f.owner.batch).is_equal(before)
	request = f.owner.request_recipe("R28")
	assert_bool(f.owner.confirm_recipe(request.token).ok).is_true()
	assert_bool(f.owner.confirm_recipe(request.token).ok).is_false()
	assert_int(f.owner.snapshot().fleet.reserved).is_zero()
	assert_dict(f.rear.ledger.snapshot().consumed).is_equal(f.spec.inputs)
	assert_str(f.owner.snapshot().recipe_records.R25.history[0].state).is_equal("Cancelled")
	assert_str(f.owner.bay_occupant).is_empty()
	assert_array(f.rear.audit()).is_empty()

func test_real_staff_local_inputs_pause_access_and_parking_edits_preserve_promises_and_work() -> void:
	var f := _fixture("R31",0)
	assert_bool(f.owner.accept_order().ok).is_true()
	_seed(f)
	f.rear.advance_time(100)
	assert_dict(f.rear.ledger.snapshot().consumed).is_empty()
	for i in 8: f.rear.add_person("later-%d"%i,false,"None","duty-vehicle_works")
	f.rear.set_target("vehicle_works",8)
	f.rear.advance_time(10)
	assert_float(f.owner.batch.work).is_equal(80.0)
	var order: Dictionary = f.owner.snapshot().order
	var parking: Array = f.rear.yard.reserved.duplicate()
	assert_bool(f.owner.set_parking_destination(0).ok).is_false()
	assert_array(f.rear.yard.reserved).is_equal(parking)
	assert_str(f.owner.snapshot().order.id).is_equal(order.id)
	assert_bool(f.owner.set_parking_destination(3).ok).is_true()
	assert_str(f.rear.yard.reserved[order.parking_slot]).is_empty()
	assert_str(f.rear.yard.reserved[3]).is_equal(order.id)
	assert_bool(f.rear.set_store("heavy-bay",false,0).ok).is_false()
	f.owner.set_paused(true)
	f.rear.advance_time(10)
	assert_float(f.owner.batch.work).is_equal(80.0)
	f.owner.set_paused(false)
	f.owner.set_access(false,true)
	f.rear.advance_time(10)
	assert_float(f.owner.batch.work).is_equal(80.0)
	f.owner.set_access(true,true)
	f.rear.set_target("vehicle_works",4)
	f.rear.advance_time(10)
	assert_float(f.owner.batch.work).is_equal(120.0)
	assert_int(f.owner.snapshot().fleet.reserved).is_equal(1)
	assert_array(f.rear.audit()).is_empty()

func test_every_heavy_ingredient_missing_reserved_foreign_remote_or_carried_blocks_atomic_start() -> void:
	for recipe in Heavy.CHOICES:
		for type in Fixed.RECIPES[recipe].inputs:
			for condition in ["missing","reserved","foreign","remote","carried"]:
				var f := _fixture(recipe)
				_seed(f,type)
				if condition != "missing":
					f.rear.ledger.add_stock("ineligible",type,f.spec.inputs[type],1.0,"depot" if condition=="remote" else "vehicle_input","supplier" if condition=="foreign" else f.rear.PLAYER)
					if condition in ["reserved","carried"]: f.rear.ledger.request_stock("other","ineligible",1,"operator-00","other use",f.rear.PLAYER)
					if condition == "carried": assert_bool(f.rear.ledger.begin_carry("operator-00","ineligible",1,"other").ok).is_true()
				assert_bool(f.owner.accept_order().ok).is_true()
				f.rear.advance_time(100)
				assert_dict(f.owner.batch).override_failure_message(recipe+" "+type+" "+condition).is_empty()
				assert_dict(f.rear.ledger.snapshot().consumed).is_empty()
				assert_int(f.owner.snapshot().fleet.reserved).is_equal(0 if recipe=="R13" else 1)

func test_default_access_initial_yard_and_external_services_do_not_grant_or_consume_player_fleet() -> void:
	var base := Base.new()
	assert_int(base.rear.ledger.rear_fleet_status(base.rear.PLAYER).live).is_equal(1)
	assert_int(base.rear.actors.size()).is_equal(12)
	assert_dict(base.rear.ledger.snapshot().created).is_empty()
	for recipe in Heavy.CHOICES: assert_bool(base.rear.heavy_production.recipe_accessible(recipe)).is_equal(recipe in ["R25","R28"])
	base.rear.ledger.add_carrier("supplier","rear","supplier","supplier","T01")
	base.rear.ledger.add_carrier("leased","rear",base.rear.PLAYER,base.rear.PLAYER,"T01","External service")
	assert_int(base.rear.ledger.rear_fleet_status(base.rear.PLAYER).live).is_equal(1)
	assert_bool(base.rear.heavy_production.request_recipe("R31").ok).is_false()
	var expanded := Base.new(true)
	for recipe in Heavy.CHOICES: assert_bool(expanded.rear.heavy_production.recipe_accessible(recipe)).is_true()
	assert_int(expanded.rear.ledger.rear_fleet_status(expanded.rear.PLAYER).live).is_equal(1)
	assert_dict(expanded.rear.ledger.snapshot().created).is_empty()

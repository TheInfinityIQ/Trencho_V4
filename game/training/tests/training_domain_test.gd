extends GdUnitTestSuite
const Base = preload("res://game/rear_base/base_simulation.gd")
const Rear = preload("res://game/staffing/rear_simulation.gd")
const Training = preload("res://game/training/training_service.gd")
const Receiving = preload("res://game/procurement/receiving_simulation.gd")

func _fixture(instructors: int = 2, students: int = 12, basic: bool = false) -> RefCounted:
	var rear := Rear.new("Empty")
	rear.training = Training.new(rear,func(_id: String) -> bool: return true)
	for index in instructors: rear.add_person("instructor-%02d"%index,true,"None","duty-training")
	for index in students: rear.add_person("student-%02d"%index,basic,"None","duty-training")
	rear.set_target("training",instructors)
	return rear

func _report(rear: RefCounted) -> void:
	for index in 400:
		if rear.training.snapshot().counts.Reporting == 0: break
		rear.advance_time(0.1)
	assert_int(rear.training.snapshot().counts.Reporting).is_zero()

func test_canonical_durations_prerequisites_and_access_use_declared_recipe_not_selected_recipe() -> void:
	assert_int(Training.COURSES.size()).is_equal(8)
	for course in Training.COURSES:
		assert_float(Training.COURSES[course].seconds).is_equal(120.0 if course=="P01" else (240.0 if course=="P08" else 180.0))
	var base := Base.new()
	for course in Training.COURSES:
		assert_bool(base.rear.training.course_accessible(course)).override_failure_message(course).is_equal(course in ["P01","P02","P08"])
	base.rear.production.request_recipe("R08")
	base.rear.munitions_production.request_recipe("R27")
	base.rear.heavy_production.request_recipe("R28")
	assert_bool(base.rear.training.course_accessible("P02")).is_true()
	assert_bool(base.rear.training.course_accessible("P08")).is_true()
	assert_bool(base.rear.training.request_course("P03",1).ok).is_false()
	var expanded := Base.new(true)
	for course in Training.COURSES: assert_bool(expanded.rear.training.course_accessible(course)).is_true()
	for pair in [["P02",["R08"]],["P03",["R11"]],["P04",["R05","R06","R29"]],["P05",["R13"]],["P06",["R16"]],["P07",["R19"]],["P08",["R25"]]]:
		for recipe in pair[1]:
			var rear := Rear.new("Empty")
			var available: Array = [recipe]
			var service := Training.new(rear,func(id: String) -> bool: return id in available)
			assert_bool(service.course_accessible(pair[0])).is_true()
			available.clear()
			assert_bool(service.course_accessible(pair[0])).is_false()

func test_all_eight_courses_take_exact_elapsed_time_after_actual_reporting_and_grant_no_gear_or_body() -> void:
	for course in Training.COURSES:
		var rear := _fixture(1,1,course!="P01")
		var before: Dictionary = rear.ledger.snapshot()
		assert_bool(rear.training.request_course(course,1).ok).is_true()
		assert_str(rear.training.rows[0].state).is_equal("Reporting")
		assert_float(rear.training.rows[0].work).is_zero()
		_report(rear)
		var work: float = rear.training.rows[0].work
		assert_float(work).is_less(0.1)
		var seconds: float = Training.COURSES[course].seconds
		rear.advance_time(seconds-work-0.001)
		assert_str(rear.training.rows[0].state).is_equal("Active")
		rear.advance_time(0.001)
		assert_str(rear.training.rows[0].state).is_equal("Completed")
		var p: Dictionary = rear.ledger.inspect_entity("student-00")
		assert_bool(p.basic_training).is_true()
		assert_str(p.qualification).is_equal("None" if course=="P01" else course)
		assert_str(p.design_type).is_equal(course)
		assert_str(p.assignment).is_equal("Available")
		assert_int(rear.actors.size()).is_equal(2)
		assert_dict(rear.ledger.snapshot().created).is_equal(before.created)
		assert_dict(rear.ledger.snapshot().consumed).is_equal(before.consumed)
		assert_float(p.contents_mass_kg).is_zero()
		assert_array(rear.audit()).is_empty()

func test_a11_twelve_students_one_instructor_progress_six_pause_newest_then_two_cover_all() -> void:
	var rear := _fixture(2,12)
	rear.set_target("training",1)
	assert_bool(rear.training.request_course("P01",12).ok).is_true()
	assert_bool(rear.training.request_course("P01",1).ok).is_false()
	_report(rear)
	var snapshot: Dictionary = rear.training.snapshot()
	assert_int(snapshot.counts.Active).is_equal(6)
	assert_int(snapshot.counts.Paused).is_equal(6)
	var before: Array[Dictionary] = rear.training.rows.duplicate(true)
	rear.advance_time(30)
	for index in 12:
		assert_float(rear.training.rows[index].work-before[index].work).is_equal_approx(30.0 if index<6 else 0.0,0.000001)
		assert_str(rear.training.rows[index].state).is_equal("Active" if index<6 else "Paused")
	rear.set_target("training",2)
	rear.advance_time(10)
	assert_int(rear.training.snapshot().counts.Active).is_equal(12)
	assert_int(rear.training.snapshot().counts.Paused).is_zero()
	rear.set_target("training",1)
	var retained: Array[Dictionary] = rear.training.rows.duplicate(true)
	rear.advance_time(10)
	for index in 12: assert_float(rear.training.rows[index].work-retained[index].work).is_equal_approx(10.0 if index<6 else 0.0,0.000001)
	rear.set_target("training",2)
	rear.advance_time(150)
	assert_int(rear.training.snapshot().counts.Completed).is_equal(12)
	assert_int(rear.actors.size()).is_equal(14)
	assert_array(rear.audit()).is_empty()

func test_access_instructor_loss_and_partitioned_time_preserve_elapsed_progress() -> void:
	var coarse := _fixture(1,1)
	var fine := _fixture(1,1)
	for rear in [coarse,fine]:
		rear.training.request_course("P01",1)
		rear.advance_time(20)
		rear.training.set_access(false)
	var before: float = coarse.training.rows[0].work
	coarse.advance_time(60)
	for step in 60: fine.advance_time(1)
	assert_float(coarse.training.rows[0].work).is_equal(before)
	assert_float(fine.training.rows[0].work).is_equal(before)
	for rear in [coarse,fine]:
		rear.training.set_access(true)
		rear.set_target("training",0)
		rear.advance_time(20)
		assert_float(rear.training.rows[0].work).is_equal(before)
		rear.set_target("training",1)
	coarse.advance_time(200)
	for step in 200: fine.advance_time(1)
	assert_float(coarse.training.rows[0].completed_at).is_equal_approx(fine.training.rows[0].completed_at,0.000001)
	assert_bool(coarse.ledger.inspect_entity("student-00").basic_training).is_true()
	assert_array(coarse.audit()).is_empty()
	assert_array(fine.audit()).is_empty()

func test_withdrawal_basic_retention_single_specialist_and_queued_course_do_not_replace_completed_qualification() -> void:
	var rear := _fixture(1,1)
	rear.training.request_course("P01",1)
	rear.advance_time(20)
	assert_bool(rear.training.withdraw(rear.training.rows[0].id).ok).is_true()
	assert_bool(rear.ledger.inspect_entity("student-00").basic_training).is_false()
	assert_float(rear.training.rows[0].work).is_zero()
	rear.training.request_course("P01",1)
	rear.advance_time(200)
	assert_bool(rear.ledger.inspect_entity("student-00").basic_training).is_true()
	rear.training.request_course("P08",1)
	rear.advance_time(50)
	assert_bool(rear.training.withdraw(rear.training.rows[2].id).ok).is_true()
	assert_bool(rear.ledger.inspect_entity("student-00").basic_training).is_true()
	assert_str(rear.ledger.inspect_entity("student-00").qualification).is_equal("None")
	rear.training.request_course("P02",1)
	rear.advance_time(200)
	assert_str(rear.ledger.inspect_entity("student-00").qualification).is_equal("P02")
	rear.training.request_course("P08",1)
	rear.advance_time(300)
	assert_str(rear.training.rows[4].state).is_equal("Queued")
	assert_str(rear.ledger.inspect_entity("student-00").qualification).is_equal("P02")
	assert_bool(rear.ledger.complete_training("student-00","P08").ok).is_false()
	assert_array(rear.audit()).is_empty()

func test_carry_to_student_safe_handoff_and_withdraw_pending_request_preserve_person_and_freight() -> void:
	for withdraw in [false,true]:
		var rear := _fixture(1,1)
		rear.ledger.move_entity("student-00","rear",rear.Layout.door("depot"))
		rear.ledger.add_stock("metal","M01",25,1.0,"depot",rear.PLAYER)
		rear.set_target("hauling",1)
		rear.request_haul("depot","workshop_input","M01",25)
		for step in 500:
			rear.advance_time(0.1)
			if not rear.ledger.inspect_entity("student-00").carrying_stock_id.is_empty(): break
		assert_str(rear.ledger.inspect_entity("student-00").carrying_stock_id).is_not_empty()
		rear.training.request_course("P01",1)
		assert_str(rear.ledger.inspect_entity("student-00").duty_id).is_equal("hauling")
		assert_str(rear.ledger.inspect_entity("student-00").pending_duty).is_equal("students")
		rear.advance_time(1)
		assert_float(rear.training.rows[0].work).is_zero()
		if withdraw: rear.training.withdraw(rear.training.rows[0].id)
		rear.advance_time(300)
		assert_int(rear.ledger.available_stock_at("workshop_input","M01")).is_equal(25)
		assert_bool(rear.ledger.inspect_entity("student-00").basic_training).is_equal(not withdraw)
		assert_int(rear.actors.size()).is_equal(2)
		assert_array(rear.audit()).is_empty()

func test_recovery_one_pending_shared_personnel_and_population_reservations_are_atomic() -> void:
	var base := Base.new()
	var service: RefCounted = base.receiving
	assert_bool(service.buy_recovery_instructor().ok).is_true()
	assert_int(service.incoming_people()).is_equal(1)
	assert_int(service.personnel_admitted()).is_equal(1)
	assert_float(service.snapshot().money).is_equal(2380.0)
	var before: Dictionary = service.snapshot()
	assert_bool(service.buy_recovery_instructor().ok).is_false()
	assert_dict(service.snapshot()).is_equal(before)
	assert_bool(service.buy_people().ok).is_true()
	assert_int(service.personnel_admitted()).is_equal(2)
	assert_int(service.incoming_people()).is_equal(9)
	base.rear.advance_time(5)
	assert_bool(service.cancel_order("delivery-0001").ok).is_false()
	base.rear.advance_time(84.9)
	assert_int(base.rear.actors.size()).is_equal(12)
	assert_bool(service.recovery_instructor_offer().available).is_false()
	base.rear.advance_time(100)
	assert_int(base.rear.actors.size()).is_equal(21)
	assert_bool(base.rear.ledger.inspect_entity("delivery-0001-person-01").basic_training).is_true()
	assert_str(base.rear.ledger.inspect_entity("delivery-0001-person-01").qualification).is_equal("None")
	assert_bool(base.rear.actors.has("delivery-0001-driver")).is_false()
	assert_int(base.rear.ledger.rear_fleet_status(base.rear.PLAYER).live).is_equal(1)
	assert_bool(service.recovery_instructor_offer().available).is_false()
	assert_array(base.audit()).is_empty()
	var full := Base.new()
	for index in 108: full.rear.add_person("extra-%03d"%index)
	before = full.receiving.snapshot()
	assert_bool(full.receiving.buy_recovery_instructor().ok).is_false()
	assert_dict(full.receiving.snapshot()).is_equal(before)
	var queued := Base.new()
	queued.receiving.buy_people()
	queued.receiving.buy_people()
	before = queued.receiving.snapshot()
	assert_bool(queued.receiving.buy_recovery_instructor().ok).is_false()
	assert_dict(queued.receiving.snapshot()).is_equal(before)
	var cancelled := Base.new()
	cancelled.receiving.buy_recovery_instructor()
	assert_bool(cancelled.receiving.cancel_order("delivery-0001").ok).is_true()
	assert_bool(cancelled.receiving.cancel_order("delivery-0001").ok).is_false()
	assert_float(cancelled.receiving.snapshot().money).is_equal(2500.0)
	assert_bool(cancelled.receiving.recovery_instructor_offer().available).is_true()
	assert_int(cancelled.receiving.incoming_people()).is_zero()

func test_normal_zero_unloader_recovery_basic_and_p08_keep_same_identity_no_goods_or_bay_clearance() -> void:
	var base := Base.new()
	base.receiving.buy_resources({"M01":1})
	base.receiving.buy_recovery_instructor()
	base.rear.advance_time(150)
	assert_int(base.receiving.receiving_kg()).is_zero()
	assert_str(base.receiving.snapshot().orders[0].blocked_reason).contains("Missing actual")
	var person: Dictionary = base.rear.ledger.inspect_entity("delivery-0002-person-01")
	assert_bool(person.basic_training).is_true()
	base.rear.set_target("training",1)
	base.rear.training.request_course("P01",1)
	base.rear.advance_time(300)
	var student: String = base.rear.training.rows[0].person_id
	base.rear.training.request_course("P08",1)
	base.rear.advance_time(300)
	assert_str(base.rear.training.rows[1].person_id).is_equal(student)
	assert_str(base.rear.ledger.inspect_entity(student).qualification).is_equal("P08")
	assert_int(base.rear.actors.size()).is_equal(13)
	assert_int(base.rear.ledger.rear_fleet_status(base.rear.PLAYER).live).is_equal(1)
	assert_str(base.rear.heavy_production.bay_occupant).is_empty()
	assert_dict(base.rear.ledger.snapshot().created).is_equal({"M01":1})
	assert_array(base.audit()).is_empty()

func test_carrying_instructor_reports_only_after_safe_deposit_and_students_wait_without_labour_overlap() -> void:
	var rear := _fixture(1,1)
	rear.set_target("training",0)
	rear.ledger.move_entity("instructor-00","rear",rear.Layout.door("depot"))
	rear.ledger.add_stock("metal","M01",25,1.0,"depot",rear.PLAYER)
	rear.set_target("hauling",1)
	# Prefer actual trained incumbent for this declared hauling setup.
	rear.reassign_person("instructor-00","hauling")
	rear.request_haul("depot","workshop_input","M01",25)
	for step in 500:
		rear.advance_time(0.1)
		if not rear.ledger.inspect_entity("instructor-00").carrying_stock_id.is_empty(): break
	assert_str(rear.ledger.inspect_entity("instructor-00").carrying_stock_id).is_not_empty()
	rear.training.request_course("P01",1)
	rear.set_target("training",1,2)
	assert_str(rear.ledger.inspect_entity("instructor-00").pending_duty).is_equal("training")
	rear.advance_time(1)
	assert_float(rear.training.rows[0].work).is_zero()
	assert_array(rear.training.instructors()).is_empty()
	rear.advance_time(300)
	assert_int(rear.ledger.available_stock_at("workshop_input","M01")).is_equal(25)
	assert_str(rear.ledger.inspect_entity("instructor-00").duty_id).is_equal("training")
	assert_bool(rear.ledger.inspect_entity("student-00").basic_training).is_true()
	assert_int(rear.actors.size()).is_equal(2)
	assert_array(rear.audit()).is_empty()

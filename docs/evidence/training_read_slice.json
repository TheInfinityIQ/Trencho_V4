      "game/staffing/rear_simulation.gd"
    ],
    "driver_migration": "RearSimulation.advance_time and global _settle are still active. No training time driver, deadline scheduler or committed-change outbox was replaced in this slice.",
    "first_party_source_policy": "Retained tests/fixtures remain in the game source inventory. Isolated projects contain generated comparison snapshots and the pinned third-party test addon; no editor addon is enabled in the normal project.",
    "preserved": "Empty opening/start, pause/speed and physical logistics rules, training durations/access/withdrawal/qualifications, nine frozen training projections and the existing 13 domain hashes."
  },
  "changes": [
    {
      "area": "Scoped Train view",
      "implementation": "BaseSimulation.training_view combines purchasing/common HUD facts, one current training export and only selected-student facts. BaseDemo routes normal Train to it and uses a common training renderer. Other advanced panels and HQ diagnostics retain their existing broad path."
    },
    {
      "area": "Local read reuse",
      "implementation": "Training.snapshot retains _refresh_states normalization and reuses one fresh instructor list for its returned IDs and coverage. There is no cross-callback cache or new authority."
    },
    {
      "area": "Command boundary",
      "implementation": "Training results declare requires_reconciliation. Audited read-only rejected requests return false; BaseDemo skips after_command and session-wide notify_command for them while keeping local feedback/refresh. Legacy unannotated and accepted training results retain their reconciliation guarantees."
    },
    {
      "area": "Diagnostics",
      "implementation": "Record request/withdraw/access and staffing-target entries so tests can distinguish actual commands from presentation updates. No sampling or dropped-call shortcut was introduced."
    },
    {
      "area": "Tests and launcher",
      "implementation": "Add nine training read/result guards, update the obsolete native training suite to four current cases and explicitly select the nine retained domain cases. Default selection is now 36 aggregate cases; TrainingOnly selects 22 rendered or 18 headless cases, TrainingUiOnly selects four native cases."
    },
    {
      "area": "Clickable chart",
      "implementation": "Add source-checked Train read and command workflows and document conditional reconciliation/notification. Existing VS Code source links and static-graph uncertainty are preserved."
    }
  ],
